package com.example.controller;

import com.example.model.ApiResponse;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.time.LocalDateTime;
import java.util.List;

@RestController
@RequestMapping("/api")
public class ProdutoController {

    /**
     * GET /api/produtos
     * Retorna uma lista estática de produtos.
     */
    @GetMapping("/produtos")
    public ResponseEntity<ApiResponse> getProdutos() {

        List<ApiResponse.Produto> produtos = List.of(
            new ApiResponse.Produto(1L, "Notebook Dell XPS",    "Eletrônicos",  7499.90, true),
            new ApiResponse.Produto(2L, "Mouse Logitech MX",    "Periféricos",   299.90, true),
            new ApiResponse.Produto(3L, "Teclado Mecânico HyperX", "Periféricos", 549.00, false),
            new ApiResponse.Produto(4L, "Monitor LG 27\"",      "Eletrônicos",  2199.00, true),
            new ApiResponse.Produto(5L, "Cadeira Gamer DXRacer","Mobiliário",   1899.99, true)
        );

        ApiResponse response = new ApiResponse(
            "✅ API rodando com sucesso dentro do Docker!",
            LocalDateTime.now(),
            produtos
        );

        return ResponseEntity.ok(response);
    }

    /**
     * GET /api/info
     * Retorna informações sobre o serviço.
     */
    @GetMapping("/info")
    public ResponseEntity<?> getInfo() {
        return ResponseEntity.ok(java.util.Map.of(
            "servico",   "spring-docker-api",
            "versao",    "1.0.0",
            "java",      System.getProperty("java.version"),
            "status",    "UP",
            "timestamp", LocalDateTime.now().toString()
        ));
    }
}
