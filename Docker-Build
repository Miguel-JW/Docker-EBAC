# ─────────────────────────────────────────────
# Estágio 1 — BUILD
# Usa Maven + JDK 17 para compilar e empacotar
# ─────────────────────────────────────────────
FROM maven:3.9.4-eclipse-temurin-17 AS build

WORKDIR /app

# Copia o pom.xml primeiro para aproveitar o cache do Docker
# (só baixa dependências novamente se o pom.xml mudar)
COPY pom.xml .
RUN mvn dependency:go-offline -B

# Copia o código-fonte e empacota sem rodar testes
COPY src ./src
RUN mvn clean package -DskipTests


# ─────────────────────────────────────────────
# Estágio 2 — RUNTIME
# Usa apenas o JRE (imagem menor, ~180MB vs ~500MB)
# ─────────────────────────────────────────────
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# Copia apenas o JAR gerado no estágio anterior
COPY --from=build /app/target/spring-docker-api-0.0.1-SNAPSHOT.jar app.jar

# Documenta a porta exposta pelo container
EXPOSE 8080

# Comando de inicialização da aplicação
ENTRYPOINT ["java", "-jar", "app.jar"]
